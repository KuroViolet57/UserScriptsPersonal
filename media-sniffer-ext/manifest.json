{
  "manifest_version": 3,
  "name": "Media Vault",
  "version": "1.4.1",
  "description": "Media sniffer with full network coverage: detects video/audio/streams via webRequest (any frame, any format, headers included), lists them with size and filters, adds an on-video button, and downloads through the browser's download manager.",
  "permissions": [
    "webRequest",
    "storage",
    "unlimitedStorage",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Media Vault",
    "default_popup": "media.html",
    "default_icon": {
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": "",
  "web_accessible_resources": [
    {
      "resources": [
        "media.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "icons": {
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}